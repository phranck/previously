.DS_Store

# The venv is for developing on a Mac, where pip is blocked by PEP 668. On the
# Pi everything comes from Debian packages, so nothing here is ever deployed.
admin/.venv/
__pycache__/
.pytest_cache/
*.pyc

# What packaging/build.py lays out and writes. Built from the tree beside it,
# so keeping it would be keeping a copy of the repository in the repository.
admin/packaging/build/

# An index one editing assistant keeps of this tree. It is rebuilt from the
# source on demand and says nothing about the project.
.serena/

# What the linter is installed from. Nothing here is deployed either: the Pi
# runs the built interface, and esbuild and eslint are what a person building
# it needs on their own machine.
admin/node_modules/
admin/package-lock.json

# Where the browser automation leaves its snapshots whilst a page is being
# looked at.
.playwright-mcp/
