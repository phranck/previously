.DS_Store

# The venv is for developing on a Mac, where pip is blocked by PEP 668. On the
# Pi everything comes from Debian packages, so nothing here is ever deployed.
admin/.venv/
__pycache__/
.pytest_cache/
*.pyc

# What packaging/build.py lays out and writes. Built from the tree beside it,
# so keeping it would be keeping a copy of the repository in the repository.
admin/packaging/build/
