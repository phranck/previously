--- src/tmc.c	(revision 1859)
+++ src/tmc.c	(working copy)
@@ -14,6 +14,7 @@
 #include "sysReg.h"
 #include "adb.h"
 #include "tmc.h"
+#include "screen.h"
 
 #define LOG_TMC_LEVEL LOG_DEBUG
 
@@ -217,10 +218,104 @@
 	return (tmc.video_intr&TMC_VI_ENABLE);
 }
 
+/* Playground: the kernel of a turbo machine sizes its monochrome screen from
+ * the display counts in these two registers, width as pixels per four and
+ * height as lines, both in the low twelve bits. The counts follow
+ * PREVIOUS_SCREEN_W and PREVIOUS_SCREEN_H when they are set, and a write by
+ * the ROM or the kernel cannot move them, so the guest sees a display of that
+ * size however its firmware programs the timing. */
+#define TMC_DISPLAY_COUNT_MASK 0xFFF
+
+static uint32_t tmc_display_width_count  = HDISCNT;
+static uint32_t tmc_display_height_count = VDISCNT;
+
+static uint32_t tmc_count_from_env(const char* name, uint32_t fallback, uint32_t pixels_per_count) {
+	const char* text = getenv(name);
+	long value = (text && *text) ? strtol(text, NULL, 10) : 0;
+	if (value > 0) {
+		return ((uint32_t)value / pixels_per_count) & TMC_DISPLAY_COUNT_MASK;
+	}
+	return fallback;
+}
+
+static void tmc_hold_display_counts(void) {
+	tmc.horizontal = (tmc.horizontal & ~TMC_DISPLAY_COUNT_MASK) | tmc_display_width_count;
+	tmc.vertical   = (tmc.vertical   & ~TMC_DISPLAY_COUNT_MASK) | tmc_display_height_count;
+}
+
+/* Playground: the handover from firmware to operating system. The ROM sits
+ * below 0x02000000 in the address map, in its two windows, and RAM begins at
+ * 0x04000000, so a read of the display counts from a program counter above
+ * the ROM windows is the kernel's. */
+volatile bool tmc_display_counts_read_by_os = false;
+
+#define TMC_VID_REG_HCR      8
+#define TMC_VID_REG_VCR_END  16
+#define NEXT_ROM_WINDOWS_END 0x02000000
+
+/* The firmware painted the frame buffer for its own geometry, and with the
+ * kernel's row length that picture reads as stripes until something paints
+ * over it, which the kernel's boot panel does only in the middle. So when the
+ * kernel takes the screen, what the firmware left is wiped to NeXT's dark
+ * gray, the color both the ROM and the kernel's panel stand on. The wipe
+ * covers the firmware's picture and the configured screen, within the VRAM. */
+#define NEXT_VRAM_GRAY_BYTES 0x40000
+#define NEXT_GRAY_FILL_BYTE  0xAA
+
+static void tmc_wipe_firmware_picture(void) {
+	size_t firmware_bytes   = (size_t)(NeXT_FIRMWARE_SCRN_W / 4) * NeXT_FIRMWARE_SCRN_H;
+	size_t configured_bytes = (size_t)(NeXT_SCRN_W / 4) * NeXT_SCRN_H;
+	size_t bytes = firmware_bytes > configured_bytes ? firmware_bytes : configured_bytes;
+
+	if (NeXT_SCRN_W == NeXT_FIRMWARE_SCRN_W && NeXT_SCRN_H == NeXT_FIRMWARE_SCRN_H) {
+		return;
+	}
+	if (bytes > NEXT_VRAM_GRAY_BYTES) {
+		bytes = NEXT_VRAM_GRAY_BYTES;
+	}
+	if (NEXTVideo) {
+		memset(NEXTVideo, NEXT_GRAY_FILL_BYTE, bytes);
+	}
+}
+
+static void tmc_note_display_count_read(uint32_t addr) {
+	uint32_t reg = addr & 0xF;
+	if (reg >= TMC_VID_REG_HCR && reg < TMC_VID_REG_VCR_END && m68k_getpc() >= NEXT_ROM_WINDOWS_END) {
+		if (!tmc_display_counts_read_by_os) {
+			tmc_display_counts_read_by_os = true;
+			tmc_wipe_firmware_picture();
+		}
+	}
+}
+
+/* Playground: with PREVIOUS_TMC_TRACE set, every access to the video
+ * configuration registers is printed with the program counter, so a boot
+ * shows which code reads the display counts and which writes them. Reads are
+ * capped, because a driver may poll them. */
+#define TMC_TRACE_READS_AT_MOST 64
+
+static void tmc_trace_video_access(const char* what, uint32_t addr, uint32_t val) {
+	static int enabled = -1;
+	static int reads = 0;
+	if (enabled < 0) {
+		const char* text = getenv("PREVIOUS_TMC_TRACE");
+		enabled = (text && *text) ? 1 : 0;
+	}
+	if (!enabled) {
+		return;
+	}
+	if (what[0] == 'r' && reads++ >= TMC_TRACE_READS_AT_MOST) {
+		return;
+	}
+	fprintf(stderr, "[TMC trace] %s video reg +%02x val=%08x pc=%08x\n", what, addr & 0xFF, val, m68k_getpc());
+}
+
