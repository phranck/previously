 /* **** VRAM for monochrome systems **** */
 
+/* Playground: the firmware draws for the hardware's own screen, 1120 by 832
+ * with rows of 280 bytes, whatever size the guest is told through the TMC
+ * display counts, because the ROM fills its console record with constants and
+ * places its panels at fixed coordinates. The kernel hands the screen back to
+ * that drawing during boot, between its own panels. When the configured screen
+ * differs, every access that firmware code makes to the firmware's visible
+ * picture is moved into the middle of the configured screen, so the ROM's
+ * panels keep their shape and sit centered. The parts of that picture the
+ * configured screen does not show live in a shadow, so firmware code reads
+ * back what it wrote there. With those writes dropped, the ROM stops right
+ * after power-on. Offsets past the picture stay where they are. That part of
+ * the VRAM holds the firmware's message buffer at 0x3fe00.
+ *
+ * Firmware code is code in supervisor mode below the end of the ROM windows:
+ * the kernel runs from 0x04000000 up, and programs at lower addresses run in
+ * user mode. Only a turbo machine in gray takes another screen size (see
+ * Screen_GeometryFromEnvironment), and its rows hold exactly the width. */
+#define NEXT_ROM_WINDOWS_END     0x02000000
+#define FIRMWARE_ROW_BYTES       (NeXT_FIRMWARE_SCRN_W / 4)
+#define FIRMWARE_PICTURE_BYTES   (FIRMWARE_ROW_BYTES * NeXT_FIRMWARE_SCRN_H)
+
+static uae_u8 firmware_shadow[FIRMWARE_PICTURE_BYTES];
+
+static bool vram_access_by_firmware(void)
+{
+	return (NeXT_SCRN_W != NeXT_FIRMWARE_SCRN_W || NeXT_SCRN_H != NeXT_FIRMWARE_SCRN_H)
+		&& regs.s && m68k_getpc() < NEXT_ROM_WINDOWS_END;
+}
+
+/* Where a byte of the firmware's view of the VRAM lives: in the configured
+ * screen, in the shadow where that screen does not reach, or unmoved past the
+ * firmware's picture. The horizontal shift is a multiple of four bytes, so an
+ * aligned long stays aligned and lands wholly in one of these places. */
+static uae_u8* vram_firmware_byte(uae_u32 offset)
+{
+	int screen_row_bytes = NeXT_SCRN_W / 4;
+	int row, byte;
+
+	offset &= NEXT_VRAM_MASK;
+	if (offset >= FIRMWARE_PICTURE_BYTES) {
+		return NEXTVideo + offset;
+	}
+	row  = (int)(offset / FIRMWARE_ROW_BYTES) + (NeXT_SCRN_H - NeXT_FIRMWARE_SCRN_H) / 2;
+	byte = (int)(offset % FIRMWARE_ROW_BYTES) + (((screen_row_bytes - FIRMWARE_ROW_BYTES) / 2) & ~3);
+	if (row < 0 || row >= NeXT_SCRN_H || byte < 0 || byte >= screen_row_bytes) {
+		return firmware_shadow + offset;
+	}
+	return NEXTVideo + (long)row * screen_row_bytes + byte;
+}
+
+/* Reads size bytes for firmware code: in one piece where they lie side by
+ * side, byte by byte where they do not. */
+static uae_u32 vram_firmware_get(uae_u32 offset, int size)
+{
+	uae_u8* first = vram_firmware_byte(offset);
+	uae_u32 value = 0;
+	int i;
+
+	if (vram_firmware_byte(offset + size - 1) == first + size - 1) {
+		switch (size) {
+			case 4:  return do_get_mem_long(first);
+			case 2:  return do_get_mem_word(first);
+			default: return *first;
+		}
+	}
+	for (i = 0; i < size; i++) {
+		value = (value << 8) | *vram_firmware_byte(offset + i);
+	}
+	return value;
+}
+
+/* Writes size bytes for firmware code: in one piece where they lie side by
+ * side, byte by byte where they do not. */
+static void vram_firmware_put(uae_u32 offset, uae_u32 value, int size)
+{
+	uae_u8* first = vram_firmware_byte(offset);
+	int i;
+
+	if (vram_firmware_byte(offset + size - 1) == first + size - 1) {
+		switch (size) {
+			case 4:  do_put_mem_long(first, value); return;
+			case 2:  do_put_mem_word(first, value); return;
+			default: *first = value; return;
+		}
+	}
+	for (i = 0; i < size; i++) {
+		*vram_firmware_byte(offset + i) = (uae_u8)(value >> (8 * (size - 1 - i)));
+	}
+}
+
+/* Playground: NeXTSTEP 3.3's gray screen driver draws the cursor and takes it
+ * away again with a row length of its own, 70 longs for the 1120 pixels of a
+ * turbo screen, in a `moveq #$46,d5` in each of the two routines. Everything
+ * else in the kernel takes the row length from its screen record. So once the
+ * kernel is loaded, both immediates are set to the configured width in longs.
+ * The words around each are checked first, and any kernel whose words differ
+ * is left as it is. A moveq holds at most 127, which is 2032 pixels. */
+#define CURSOR_STRIDE_CHECKED_WORDS 5
+#define CURSOR_STRIDE_MOVEQ_WORD    2
+#define CURSOR_STRIDE_MOVEQ_D5      0x7a00
+#define CURSOR_STRIDE_MOVEQ_MAX     127
+#define PIXELS_PER_LONG             16
+
+static const struct {
+	uaecptr start;                              /* where the checked words begin in /sdmach */
+	uae_u16 words[CURSOR_STRIDE_CHECKED_WORDS]; /* the words there, the moveq among them */
+} kernel_cursor_strides[] = {
+	{ 0x040978a6, { 0x3c3c, 0x0139, 0x7a46, 0x2d45, 0xfff8 } }, /* draws the cursor */
+	{ 0x04097a40, { 0x327c, 0x0139, 0x7a46, 0x2d45, 0xfffc } }  /* takes it away */
+};
+#define KERNEL_CURSOR_STRIDES (sizeof(kernel_cursor_strides) / sizeof(kernel_cursor_strides[0]))
+
+void memory_fit_kernel_cursor(void)
+{
+	uae_u16 fitted = CURSOR_STRIDE_MOVEQ_D5 | (NeXT_SCRN_W / PIXELS_PER_LONG);
+	size_t site;
+	int i;
+
+	if (NeXT_SCRN_W == NeXT_FIRMWARE_SCRN_W || NeXT_SCRN_W / PIXELS_PER_LONG > CURSOR_STRIDE_MOVEQ_MAX) {
+		return;
+	}
+	for (site = 0; site < KERNEL_CURSOR_STRIDES; site++) {
+		for (i = 0; i < CURSOR_STRIDE_CHECKED_WORDS; i++) {
+			uae_u16 found = get_word(kernel_cursor_strides[site].start + 2 * i);
+			uae_u16 expected = kernel_cursor_strides[site].words[i];
+			if (found != expected && !(i == CURSOR_STRIDE_MOVEQ_WORD && found == fitted)) {
+				return;
+			}
+		}
+	}
+	for (site = 0; site < KERNEL_CURSOR_STRIDES; site++) {
+		put_word(kernel_cursor_strides[site].start + 2 * CURSOR_STRIDE_MOVEQ_WORD, fitted);
+	}
+}
+
