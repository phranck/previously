+/*
+ Playground: the main screen's size from PREVIOUS_SCREEN_W and
+ PREVIOUS_SCREEN_H. The width is kept to a multiple of sixteen, because the
+ kernel's cursor code steps through rows in longs of sixteen gray pixels.
+ Only a turbo machine in gray takes another size, because only its kernel
+ reads the screen size from the TMC counts; the other machines keep constants.
+ */
+#define NEXT_SCRN_WIDTH_STEP 16
+
+void Screen_ConfiguredSize(int* width, int* height) {
+	const char* text_w = getenv("PREVIOUS_SCREEN_W");
+	const char* text_h = getenv("PREVIOUS_SCREEN_H");
+	int env_w = text_w ? atoi(text_w) : 0;
+	int env_h = text_h ? atoi(text_h) : 0;
+	bool machine_reads_counts = ConfigureParams.System.bTurbo && !ConfigureParams.System.bColor;
+
+	*width  = NeXT_FIRMWARE_SCRN_W;
+	*height = NeXT_FIRMWARE_SCRN_H;
+	if (machine_reads_counts && env_w >= NEXT_SCRN_LEAST && env_h >= NEXT_SCRN_LEAST) {
+		*width  = env_w - env_w % NEXT_SCRN_WIDTH_STEP;
+		*height = env_h;
+	}
+}
+
+static void Screen_GeometryFromEnvironment(void) {
+	Screen_ConfiguredSize(&NeXT_SCRN_W, &NeXT_SCRN_H);
+	screen_w = width  = NeXT_SCRN_W;
+	screen_h = height = NeXT_SCRN_H;
+}
