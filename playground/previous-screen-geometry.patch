@@ -518,6 +518,37 @@
 
 /* **** VRAM for monochrome systems **** */
 
+/* Playground: with PREVIOUS_TMC_TRACE set, writes to the frame buffer by ROM
+ * code after the kernel has taken the screen are counted, and the first few
+ * are printed with their program counter, to learn what still draws with the
+ * firmware's row length once the kernel draws with the configured one. */
+#define VRAM_TRACE_FIRST_WRITES 8
+#define VRAM_TRACE_EVERY_WRITES 20000
+#define VRAM_TRACE_ROM_WINDOWS_END 0x02000000
+
+static void vram_trace_rom_write(uaecptr addr, uae_u32 val)
+{
+	static int enabled = -1;
+	static unsigned count = 0;
+	uae_u32 pc;
+
+	if (enabled < 0) {
+		const char* text = getenv("PREVIOUS_TMC_TRACE");
+		enabled = (text && *text) ? 1 : 0;
+	}
+	if (!enabled || !tmc_display_counts_read_by_os) {
+		return;
+	}
+	pc = m68k_getpc();
+	if (pc >= VRAM_TRACE_ROM_WINDOWS_END) {
+		return;
+	}
+	count++;
+	if (count <= VRAM_TRACE_FIRST_WRITES || (count % VRAM_TRACE_EVERY_WRITES) == 0) {
+		fprintf(stderr, "[VRAM trace] ROM-code write #%u addr=%08x val=%08x pc=%08x\n", count, addr, val, pc);
+	}
+}
+
 static uae_u32 mem_video_lget(uaecptr addr)
 {
 	addr &= NEXT_VRAM_MASK;
@@ -538,6 +569,7 @@
 
 static void mem_video_lput(uaecptr addr, uae_u32 l)
 {
+	vram_trace_rom_write(addr, l);
 	addr &= NEXT_VRAM_MASK;
 	do_put_mem_long(NEXTVideo + addr, l);
 }
@@ -544,6 +576,7 @@
 
 static void mem_video_wput(uaecptr addr, uae_u32 w)
 {
+	vram_trace_rom_write(addr, w);
 	addr &= NEXT_VRAM_MASK;
 	do_put_mem_word(NEXTVideo + addr, w);
 }
@@ -550,6 +583,7 @@
 
 static void mem_video_bput(uaecptr addr, uae_u32 b)
 {
+	vram_trace_rom_write(addr, b);
 	addr &= NEXT_VRAM_MASK;
 	NEXTVideo[addr] = b;
 }
