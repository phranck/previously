+/* Playground: the kernel of a turbo machine sizes its monochrome screen from
+ * the display counts in these two registers, width as pixels per four and
+ * height as lines, both in the low twelve bits. The counts follow the
+ * configured screen (Screen_ConfiguredSize), and a write by the ROM or the
+ * kernel cannot move them, so the guest sees a display of that size however
+ * its firmware programs the timing. */
+#define TMC_DISPLAY_COUNT_MASK      0xFFF
+#define TMC_PIXELS_PER_WIDTH_COUNT  4
+
+static uint32_t tmc_display_width_count  = HDISCNT;
+static uint32_t tmc_display_height_count = VDISCNT;
+
+static void tmc_hold_display_counts(void) {
+	tmc.horizontal = (tmc.horizontal & ~TMC_DISPLAY_COUNT_MASK) | tmc_display_width_count;
+	tmc.vertical   = (tmc.vertical   & ~TMC_DISPLAY_COUNT_MASK) | tmc_display_height_count;
+}
+
+/* Playground: with PREVIOUS_TMC_TRACE set, every access to the video
+ * configuration registers is printed with the program counter, so a boot
+ * shows which code reads the display counts and which writes them. Reads are
+ * capped, because a driver may poll them. */
+#define TMC_TRACE_READS_AT_MOST 64
+
+static void tmc_trace_video_access(const char* what, uint32_t addr, uint32_t val) {
+	static int enabled = -1;
+	static int reads = 0;
+	if (enabled < 0) {
+		const char* text = getenv("PREVIOUS_TMC_TRACE");
+		enabled = (text && *text) ? 1 : 0;
+	}
+	if (!enabled) {
+		return;
+	}
+	if (what[0] == 'r' && reads++ >= TMC_TRACE_READS_AT_MOST) {
+		return;
+	}
+	fprintf(stderr, "[TMC trace] %s video reg +%02x val=%08x pc=%08x\n", what, addr & 0xFF, val, m68k_getpc());
+}
+
+/* Playground: the kernel reads the display counts when it builds its screen
+ * record. By then it is loaded, and nothing has drawn the cursor yet, so that
+ * is when its cursor code gets the configured row length. */
+#define TMC_VID_REG_HCR    8
+#define KERNEL_TEXT_START  0x04000000
+
+static void tmc_note_count_read(uint32_t addr) {
+	if ((addr & 0xF) == TMC_VID_REG_HCR && m68k_getpc() >= KERNEL_TEXT_START) {
+		memory_fit_kernel_cursor();
+	}
+}
