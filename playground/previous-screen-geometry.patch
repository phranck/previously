--- src/video.c	(revision 1859)
+++ src/video.c	(working copy)
@@ -20,10 +20,28 @@
 #include "dma.h"
 #include "sysReg.h"
 #include "tmc.h"
+#include "grab.h"
 
 
 #define NEXT_VBL_FREQ 68
 
+/* Playground: a grab of the frame buffer every PREVIOUS_GRAB_EVERY seconds,
+ * so a boot can be read off files without anybody at the window. It runs on
+ * the CPU thread once per vertical blank, which is the thread that writes the
+ * frame buffer the grab reads. */
+static void Video_PeriodicGrab(void) {
+	static int grab_every_vbl = -1;
+	static int vbl_count = 0;
+	if (grab_every_vbl < 0) {
+		const char* text = getenv("PREVIOUS_GRAB_EVERY");
+		grab_every_vbl = (text && atoi(text) > 0) ? atoi(text) * NEXT_VBL_FREQ : 0;
+	}
+	if (grab_every_vbl > 0 && ++vbl_count >= grab_every_vbl) {
+		vbl_count = 0;
+		Grab_Screen();
+	}
+}
+
 /*-----------------------------------------------------------------------*/
 /**
  * Start VBL interrupt.
@@ -71,6 +89,7 @@
 	Timing_BlankCount(MAIN_DISPLAY, true);
 	Screen_StatusbarUpdate();
 	Video_Interrupt();
+	Video_PeriodicGrab();
 	CycInt_UpdateTimeEvent((1000*1000)/NEXT_VBL_FREQ, 0, EVENT_VIDEO_VBL);
 #else
 	static bool bBlankToggle = false;
@@ -77,6 +96,7 @@
 	Timing_BlankCount(MAIN_DISPLAY, bBlankToggle);
 	if (bBlankToggle) {
 		Video_Interrupt();
+		Video_PeriodicGrab();
