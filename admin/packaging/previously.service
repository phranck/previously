[Unit]
Description=Web admin for the Previous emulator
Documentation=https://github.com/phranck/previously
# The configuration it reads lives in the emulator owner's home, so there is
# no point starting before that user's home is available.
After=network.target

[Service]
Type=simple
# Runs as the user who owns the emulator, never as root. Reading previous.cfg
# as anybody else would need permissions this service should not have.
User=next
Group=next
ExecStart=/usr/bin/python3 -m previously
WorkingDirectory=/usr/lib/previously
Environment=PYTHONPATH=/usr/lib/previously
Restart=on-failure
RestartSec=5

# Creates /var/lib/previously owned by this user, which is the one place the
# service writes: the token it generates on first start. Everything else it
# touches, it only reads.
StateDirectory=previously
StateDirectoryMode=0750

# And what it keeps only whilst the machine is up, which is the file that holds
# the emulator down. A tmpfs, so the board comes back to an empty one and the
# console starts the emulator by itself whoever switched it off before.
RuntimeDirectory=previously
RuntimeDirectoryMode=0750

# It reads a few files and answers HTTP. Nothing else is any of its business.
NoNewPrivileges=yes
PrivateTmp=yes

# The one hole in the private /tmp. The kiosk's X server keeps its socket there,
# and pressing the emulated power button means reaching it. Read only, and one
# directory rather than the whole of /tmp.
BindReadOnlyPaths=/tmp/.X11-unix

# The one place in the home this service may write, which ProtectHome above
# otherwise forbids. Previous keeps its configuration here and this tool's job
# is to change it. The directory rather than the file, because the copy it
# makes before every write is a second file beside the first.
ReadWritePaths=-/home/next/.config/previous
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
