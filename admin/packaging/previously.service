[Unit]
Description=Web admin for the Previous emulator
Documentation=https://github.com/phranck/previously
# The configuration it reads lives in the emulator owner's home, so there is
# no point starting before that user's home is available.
After=network.target
# Runs as the user who owns the emulator, never as root. That user is whoever
# the card was made with, so the package writes them into owner.conf beside
# this unit on install, together with the places in their home it may write.
# Without that file it would run as root, so it does not start at all.
ConditionPathExists=/etc/systemd/system/previously.service.d/owner.conf

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m previously
WorkingDirectory=/usr/lib/previously
Environment=PYTHONPATH=/usr/lib/previously
# And nothing of its own in that directory. Python caches compiled modules
# beside the source by default, which puts files in /usr/lib that belong to no
# package: dpkg then leaves the directory standing on purge, because what is in
# it is not its to remove. The cost is compiling eleven small modules at every
# start, on a machine that starts this once a boot.
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5

# Creates /var/lib/previously owned by this user, which holds what the service
# owns rather than what the person does: the token it generates on first start,
# and the digest of the last configuration it wrote. Both go when the package is
# purged, which is why nothing of theirs is kept here.
StateDirectory=previously
StateDirectoryMode=0750

# And what it keeps only while the machine is up, which is the file that holds
# the emulator down. A tmpfs, so the board comes back to an empty one and the
# console starts the emulator by itself whoever switched it off before.
RuntimeDirectory=previously
RuntimeDirectoryMode=0750

# It reads a few files and answers HTTP. Nothing else is any of its business.
NoNewPrivileges=yes
PrivateTmp=yes

# The one hole in the private /tmp. The kiosk's X server keeps its socket there,
# and pressing the emulated power button means reaching it. Read only, and one
# directory rather than the whole of /tmp.
#
# Optional, because a bind whose source is absent stops the service before it
# starts, and this directory is the system's: systemd makes it at boot and the
# /tmp cleanup can take it. The package keeps it out of that cleanup and puts it
# back on install. Without it the service still starts, and only pressing the
# emulator's keys fails.
BindReadOnlyPaths=-/tmp/.X11-unix

# The places in the home this service may write, which ProtectHome below
# otherwise forbids, are in owner.conf with the user whose home it is.
# packaging/build.py says what each one is for.
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
