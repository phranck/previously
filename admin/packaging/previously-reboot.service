# Restart the machine, when previously-reboot.path says somebody asked.
#
# One exact command and nothing else. There is no argument to pass and no shell
# to pass it through, so this cannot be talked into doing anything but this.

[Unit]
Description=Restart the machine at the admin tool's request
Documentation=https://github.com/phranck/previously

[Service]
Type=oneshot
# Removed first, so a command that fails does not leave a request standing that
# the path unit would act on again.
ExecStartPre=/bin/rm -f /run/previously/reboot
# Without the wall message, because systemd writes it onto the console's tty1,
# where it would stand over the boot picture until the Pi goes dark.
ExecStart=/usr/bin/systemctl --no-wall reboot
